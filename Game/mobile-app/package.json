{
  "name": "little-routes-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.11.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:tools": "vitest run tests/toolchain.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "validate:levels": "vitest run tests/unit/level.test.ts",
    "test:e2e": "playwright test",
    "test:built": "npm run build && node scripts/test-built.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:run": "npm run build && cap run android",
    "android:targets": "cap run android --list",
    "android:open": "cap open android",
    "test:android": "node tests/native/android-smoke.mjs",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "ajv": "8.20.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
