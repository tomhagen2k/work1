          <div>
            <div style="font-weight: 600; color: #fff; margin-bottom: 4px;">Bạn có chắc chắn muốn hủy báo cáo này?</div>
            <div style="color: var(--text-muted); font-size: 12.5px;">Sau khi hủy, trạng thái đánh giá của AI sẽ được khôi phục.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer" style="padding: 12px 20px; background: rgba(0, 0, 0, 0.15); border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 10px;">
        <button class="btn btn-default" onclick="closeConfirmCancelAiFeedbackModal()">Hủy</button>
        <button class="btn btn-danger" onclick="confirmExecuteCancelAiFeedback()" style="background: #ff4d4f; border-color: #ff4d4f; color: #fff;">Xác nhận hủy</button>
      </div>
    </div>
  </div>

