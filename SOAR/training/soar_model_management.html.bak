    let selectedAlertIds = new Set();
    let currentCustomer = "PTIT";

    // View Navigation
    function switchView(viewName) {
      if (viewName === 'list') {
        document.getElementById('viewModelList').classList.remove('hidden');
        document.getElementById('viewModelDetail').classList.add('hidden');
      } else {
        document.getElementById('viewModelList').classList.add('hidden');
        document.getElementById('viewModelDetail').classList.remove('hidden');
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openModelDetail(tenantCode, defaultTab = 'versions') {
      currentCustomer = tenantCode;
      switchView('detail');
      renderVersionsTable();
      renderRunsTable();
      switchDetailTab(defaultTab);
    }

    function switchDetailTab(tabKey) {
      const tabs = ['versions', 'retrain', 'runs'];
      tabs.forEach(t => {
        const btn = document.getElementById('tabBtn' + capitalize(t));
        const content = document.getElementById('tabContent' + capitalize(t));
        if (t === tabKey) {
          btn.classList.add('active');
          content.classList.remove('hidden');
        } else {
          btn.classList.remove('active');
          content.classList.add('hidden');
        }
      });

      if (tabKey === 'retrain') {
        renderAlertsTable();
      }
    }

    function capitalize(str) { return str.charAt(0).toUpperCase() + str.slice(1); }

    // Render Versions Table
    function renderVersionsTable() {
      const tbody = document.getElementById('versionsTableBody');
      tbody.innerHTML = '';

      document.getElementById('tabCountVersions').innerText = versionsList.length;

      versionsList.forEach(v => {
        const tr = document.createElement('tr');
        if (v.isServing) {
          tr.style.background = 'rgba(22, 119, 255, 0.05)';
        }

        let statusBadgeHtml = '';
        let actionButtonsHtml = '';

        if (v.isServing) {
          statusBadgeHtml = `
            <span class="status-badge badge-serving">
              <span class="status-dot" style="background: #1677ff;"></span>
              Đang áp dụng
            </span>`;
          actionButtonsHtml = `—`;
        } else if (v.isReady) {
          statusBadgeHtml = `
            <span class="status-badge badge-ready">
              <span class="status-dot" style="background: #faad14;"></span>
              Sẵn sàng áp dụng
            </span>`;
          actionButtonsHtml = `
            <button class="btn btn-success" style="height: 28px; padding: 2px 10px; font-size: 12px;" onclick="openDeployModal('${v.tag}')">
              Áp dụng bản này
            </button>
            <button class="btn btn-default" style="height: 28px; padding: 2px 10px; font-size: 12px; margin-left: 6px;" onclick="openRunDrawer('#RT-20260930-01')">
              Xem chi tiết
            </button>`;
        } else {
          statusBadgeHtml = `<span class="status-badge badge-idle">Lưu trữ</span>`;
          actionButtonsHtml = `
            <button class="btn btn-default" style="height: 28px; padding: 2px 10px; font-size: 12px;" onclick="openRollbackModal('${v.tag}')">
              Áp dụng bản này
            </button>`;
        }

        tr.innerHTML = `
          <td><strong style="color: ${v.isServing ? 'var(--primary)' : '#fff'}; font-size: 14px;">${v.tag}</strong></td>
          <td>${v.base}</td>
          <td><span class="status-badge ${v.isServing ? 'badge-serving' : 'badge-idle'}">${v.added}</span></td>
          <td>${v.date}</td>
          <td>${v.creator}</td>
          <td>${statusBadgeHtml}</td>
          <td style="text-align: right;">${actionButtonsHtml}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Alert Pagination & Selection State
    let alertCurrentPage = 1;
    let alertPageSize = 5;

    function onAlertFilterChange() {
      alertCurrentPage = 1;
      renderAlertsTable();
    }

    function changeAlertPageSize(newSize) {
      alertPageSize = parseInt(newSize, 10);
      alertCurrentPage = 1;
      renderAlertsTable();
    }

    function goToAlertPage(targetPage) {
      if (isTrainingActive) return;
      alertCurrentPage = targetPage;
      renderAlertsTable();
    }

    function getFilteredAlerts() {
      const search = document.getElementById('alertSearchInput') ? document.getElementById('alertSearchInput').value.toLowerCase() : '';
      const statusFilter = document.getElementById('alertStatusFilter') ? document.getElementById('alertStatusFilter').value : 'ALL';
      const directionFilter = document.getElementById('alertDirectionFilter') ? document.getElementById('alertDirectionFilter').value : 'ALL';
      const reporterFilter = document.getElementById('alertReporterFilter') ? document.getElementById('alertReporterFilter').value : 'ALL';
      const timeFilter = document.getElementById('alertReportTimeFilter') ? document.getElementById('alertReportTimeFilter').value : 'ALL';

      return mockAlerts.filter(a => {
        if (search && !a.id.toLowerCase().includes(search) && !a.rule.toLowerCase().includes(search)) return false;
        if (statusFilter === 'PENDING' && a.isTrained) return false;
        if (statusFilter === 'TRAINED' && !a.isTrained) return false;
        if (directionFilter !== 'ALL' && a.direction !== directionFilter) return false;
        if (reporterFilter !== 'ALL' && a.analystUser !== reporterFilter) return false;
        if (timeFilter === 'TODAY' && a.feedbackPeriod !== 'TODAY') return false;
        if (timeFilter === '7DAYS' && !['TODAY', '7DAYS'].includes(a.feedbackPeriod)) return false;
        if (timeFilter === '30DAYS' && !['TODAY', '7DAYS', '30DAYS'].includes(a.feedbackPeriod)) return false;
        return true;
      });
    }

    // Render Alert Table in Retrain Tab with Pagination
    function renderAlertsTable() {
      const tbody = document.getElementById('alertsSelectTableBody');
      const filtered = getFilteredAlerts();
      const totalCount = filtered.length;

      document.getElementById('totalVisibleAlertsCount').innerText = totalCount;
      tbody.innerHTML = '';

      // Update badge on tab
      const pendingCount = mockAlerts.filter(a => !a.isTrained).length;
      if (document.getElementById('tabCountRetrain')) {
        document.getElementById('tabCountRetrain').innerText = pendingCount;
      }

      if (totalCount === 0) {
        tbody.innerHTML = `<tr><td colspan="12" style="text-align: center; padding: 30px; color: var(--text-muted);">Không tìm thấy cảnh báo nào phù hợp với bộ lọc.</td></tr>`;
        updateSelectionUI(selectedAlertIds.size, 0);
        renderPaginationControls(0, 1, 0, 0);
        return;
      }

      // Calculate Pagination
      const totalPages = Math.ceil(totalCount / alertPageSize) || 1;
      if (alertCurrentPage > totalPages) alertCurrentPage = totalPages;
      if (alertCurrentPage < 1) alertCurrentPage = 1;

      const startIndex = (alertCurrentPage - 1) * alertPageSize;
      const pageItems = filtered.slice(startIndex, startIndex + alertPageSize);

      pageItems.forEach(alert => {
        const tr = document.createElement('tr');
        const isChecked = selectedAlertIds.has(alert.id);
        if (isChecked) tr.classList.add('selected-row');

        tr.innerHTML = `
          <td style="text-align: center;">
            <input type="checkbox" class="custom-checkbox alert-check" 
              ${isTrainingActive ? 'disabled' : ''}
              ${isChecked ? 'checked' : ''}
              onchange="onAlertCheckChange('${alert.id}', this.checked)">
          </td>
          <td>
            <div style="display: flex; align-items: center; gap: 6px;">
              <code style="color: #fff; font-weight: 500;">${alert.id}</code>
              <button class="icon-badge-btn" style="width: 20px; height: 20px;" title="Sao chép mã" onclick="navigator.clipboard.writeText('${alert.id}'); showToast('Đã sao chép mã cảnh báo', 'success')">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
            </div>
          </td>
          <td><div style="font-weight: 500; color: #fff;">${alert.rule}</div></td>
          <td>${alert.closedDate}</td>
          <td>
            <span class="status-badge ${alert.aiVerdict === 'TP' ? 'badge-danger' : 'badge-idle'}">
              ■ ${alert.aiVerdict === 'TP' ? 'Cảnh báo thật' : 'Cảnh báo giả'} (${alert.aiScore}%)
            </span>
          </td>
          <td>
            <span class="status-badge ${alert.analystVerdict === 'FP' ? 'badge-success' : 'badge-danger'}" style="font-weight: 700; white-space: nowrap;">
              ● ${alert.analystVerdict === 'FP' ? 'Cảnh báo giả' : 'Cảnh báo thật'}
            </span>
          </td>
          <td>
            <div style="font-weight: 600; color: #fff; font-size: 13px;">${alert.analystUser}</div>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px; white-space: nowrap;">${alert.feedbackDate}</div>
          </td>
          <td style="max-width: 280px;">
            <div class="line-clamp-2" style="font-size: 12px; color: var(--text-secondary);" title="${alert.reportReason}">
              ${alert.reportReason}
            </div>
          </td>
          <td>
            <span class="direction-tag ${alert.direction === 'TP_FP' ? 'direction-tp-fp' : 'direction-fp-tp'}">
              ${alert.direction === 'TP_FP' ? 'TP ➔ FP' : 'FP ➔ TP'}
            </span>
          </td>
          <td>
            ${alert.isTrained 
              ? `<span class="status-badge badge-success">
                  <span class="status-dot" style="background:#52c41a;"></span>
                  Đã huấn luyện
                 </span>`
              : `<span class="status-badge badge-warning">
                  <span class="status-dot" style="background:#faad14;"></span>
                  Chưa huấn luyện
                 </span>`
            }
          </td>
          <td>
            <span style="font-size: 12px; color: ${alert.lastTrainedDate !== '—' ? '#fff' : 'var(--text-muted)'};">
              ${alert.lastTrainedDate}
            </span>
          </td>
          <td style="text-align: center;">
            <button class="icon-badge-btn" style="width: 28px; height: 28px; margin: auto;" title="Xem chi tiết cảnh báo" onclick="showToast('Chi tiết cảnh báo ' + '${alert.id}', 'info')">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Master select checkbox reflects current page status
      const allPageSelected = pageItems.length > 0 && pageItems.every(a => selectedAlertIds.has(a.id));
      document.getElementById('selectAllCheckbox').checked = allPageSelected;
      document.getElementById('selectAllCheckbox').disabled = isTrainingActive;
      document.getElementById('btnClearSelection').disabled = isTrainingActive;

      updateSelectionUI(selectedAlertIds.size, totalCount);
      renderPaginationControls(totalCount, totalPages, startIndex, pageItems.length);
    }

    // Helper: Build smart pagination items with ellipsis (e.g. 1, 2, 3...24, 25)
    function getPaginationItems(current, total) {
      if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
      }
      if (current <= 3) {
        return [1, 2, 3, '...', total - 1, total];
      }
      if (current >= total - 2) {
        return [1, 2, '...', total - 2, total - 1, total];
      }
      return [1, '...', current - 1, current, current + 1, '...', total];
    }

    function renderPaginationControls(totalItems, totalPages, startIndex, pageCount) {
      const infoEl = document.getElementById('alertPaginationInfo');
      const btnContainer = document.getElementById('alertPaginationButtons');
      if (!infoEl || !btnContainer) return;

      if (totalItems === 0) {
        infoEl.innerText = 'Không có cảnh báo nào';
        btnContainer.innerHTML = '';
        return;
      }

      const fromNum = startIndex + 1;
      const toNum = startIndex + pageCount;
      infoEl.innerText = `Hiển thị ${fromNum} – ${toNum} trong tổng số ${totalItems} cảnh báo`;

      let html = '';
      html += `<button class="page-btn" ${alertCurrentPage <= 1 || isTrainingActive ? 'disabled' : ''} onclick="goToAlertPage(${alertCurrentPage - 1})" title="Trang trước">‹ Trước</button>`;

      const items = getPaginationItems(alertCurrentPage, totalPages);
      items.forEach(item => {
        if (item === '...') {
          html += `<span class="page-ellipsis">...</span>`;
        } else {
          const isActive = (item === alertCurrentPage);
          html += `<button class="page-btn ${isActive ? 'active' : ''}" ${isTrainingActive ? 'disabled' : ''} onclick="goToAlertPage(${item})">${item}</button>`;
        }
      });

      html += `<button class="page-btn" ${alertCurrentPage >= totalPages || isTrainingActive ? 'disabled' : ''} onclick="goToAlertPage(${alertCurrentPage + 1})" title="Trang sau">Sau ›</button>`;

      btnContainer.innerHTML = html;
    }

    function onAlertCheckChange(alertId, isChecked) {
      if (isChecked) selectedAlertIds.add(alertId);
      else selectedAlertIds.delete(alertId);
      renderAlertsTable();
    }

    function toggleSelectAllAlerts(masterCheckbox) {
      if (isTrainingActive) return;
      const isChecked = masterCheckbox.checked;
      const filtered = getFilteredAlerts();
      const startIndex = (alertCurrentPage - 1) * alertPageSize;
      const pageItems = filtered.slice(startIndex, startIndex + alertPageSize);

      if (isChecked) {
        pageItems.forEach(a => selectedAlertIds.add(a.id));
      } else {
        pageItems.forEach(a => selectedAlertIds.delete(a.id));
      }
      renderAlertsTable();
    }

    function clearSelectedAlerts() {
      if (isTrainingActive) return;
      selectedAlertIds.clear();
      document.getElementById('selectAllCheckbox').checked = false;
      renderAlertsTable();
    }

    const MIN_TRAIN_ALERTS = 100;
    const MAX_TRAIN_ALERTS = 2000;

    function updateSelectionUI(selectedCount, totalCount) {
      document.getElementById('selectedCountText').innerText = selectedCount.toLocaleString();
      const btn = document.getElementById('btnTriggerRetrain');
      const label = document.getElementById('btnRetrainLabel');

      if (isTrainingActive) {
        btn.disabled = true;
        label.innerText = `Đang huấn luyện (#${activeRunningJobCode})...`;
        return;
      }

      if (selectedCount === 0) {
        btn.disabled = true;
        label.innerText = 'Huấn luyện';
      } else if (selectedCount < MIN_TRAIN_ALERTS) {
        btn.disabled = true;
        label.innerText = `Huấn luyện (${selectedCount} cảnh báo)`;
      } else if (selectedCount <= MAX_TRAIN_ALERTS) {
        btn.disabled = false;
        label.innerText = `Huấn luyện (${selectedCount.toLocaleString()} cảnh báo đã chọn)`;
      } else {
        btn.disabled = true;
        label.innerText = `Huấn luyện (${selectedCount.toLocaleString()} - Vượt quá tối đa 2,000)`;
      }
    }

    function selectSampleAlerts(targetCount = 100) {
      if (isTrainingActive) return;
      const filtered = getFilteredAlerts();
      const toSelect = filtered.slice(0, targetCount);
      toSelect.forEach(a => selectedAlertIds.add(a.id));
      renderAlertsTable();
      showToast(`Đã chọn nhanh ${selectedAlertIds.size} cảnh báo hợp lệ để sẵn sàng huấn luyện!`, 'success');
    }

    function resetAlertFilters() {
      if (document.getElementById('alertSearchInput')) document.getElementById('alertSearchInput').value = '';
      if (document.getElementById('alertStatusFilter')) document.getElementById('alertStatusFilter').value = 'ALL';
      if (document.getElementById('alertDirectionFilter')) document.getElementById('alertDirectionFilter').value = 'ALL';
      if (document.getElementById('alertReporterFilter')) document.getElementById('alertReporterFilter').value = 'ALL';
      if (document.getElementById('alertReportTimeFilter')) document.getElementById('alertReportTimeFilter').value = 'ALL';
      alertCurrentPage = 1;
      renderAlertsTable();
    }

    // Modal Retrain Configuration (Selecting Base Version)
    function openRetrainConfigModal() {
      if (isTrainingActive) {
        alert("Đang có phiên huấn luyện chưa kết thúc!");
        return;
      }
      if (selectedAlertIds.size < MIN_TRAIN_ALERTS) {
        showToast(`Vui lòng chọn tối thiểu ${MIN_TRAIN_ALERTS} cảnh báo để huấn luyện!`, 'warning');
        return;
      }
      if (selectedAlertIds.size > MAX_TRAIN_ALERTS) {
        showToast(`Số lượng cảnh báo vượt quá giới hạn tối đa (${MAX_TRAIN_ALERTS.toLocaleString()} cảnh báo)!`, 'warning');
        return;
      }
      const count = selectedAlertIds.size;
      if (count === 0) return;

      document.getElementById('modalRetrainAlertCount').innerText = count + ' cảnh báo';
      document.getElementById('modalRetrainCustomer').innerText = document.getElementById('detailCustomerTitle').innerText;

      // Populate base versions dropdown - DEFAULT TO LATEST VERSION
      const select = document.getElementById('modalSelectBaseVersion');
      select.innerHTML = '';
      versionsList.forEach((v, index) => {
        const opt = document.createElement('option');
        opt.value = v.tag;
        if (index === 0) {
          opt.innerText = `${v.tag} (Bản mới nhất ${v.isServing ? '- Đang áp dụng' : ''})`;
          opt.selected = true;
        } else {
          opt.innerText = `${v.tag} ${v.isServing ? '(Đang áp dụng)' : ''}`;
        }
        select.appendChild(opt);
      });

      onBaseVersionChange();
      document.getElementById('modalRetrainConfig').classList.add('active');
    }

    function onBaseVersionChange() {
      const baseTag = document.getElementById('modalSelectBaseVersion').value;
      // Predict next version tag
      const latestTag = versionsList[0].tag;
      const nextMajor = latestTag.split('.')[0];
      const nextMinor = parseInt(latestTag.split('.')[1]) + 1;
      document.getElementById('modalRetrainExpectedVersion').innerText = `${nextMajor}.${nextMinor}`;
    }

    function confirmExecuteRetrain() {
      closeModal('modalRetrainConfig');
      const count = selectedAlertIds.size;
      const chosenBase = document.getElementById('modalSelectBaseVersion').value;
      const newExpectedTag = document.getElementById('modalRetrainExpectedVersion').innerText;

      isTrainingActive = true;
      activeRunningJobCode = "#RT-20260930-01";

      showToast(`Đã khởi tạo phiên huấn luyện ${activeRunningJobCode} trên nền ${chosenBase} với ${count} cảnh báo!`, 'info');

      // Add to Runs List
      const newRun = {
        code: activeRunningJobCode,
        creator: "tomhagen",
        date: "Hôm nay 10:45",
        base: chosenBase,
        count: count,
        status: "RUNNING",
        result: `${newExpectedTag} (Dự kiến)`,
        duration: "Đang chạy..."
      };
      runsList.unshift(newRun);

      renderRunsTable();
      renderAlertsTable(); // Locks UI!

      // Switch to Runs tab and open drawer
      switchDetailTab('runs');
      setTimeout(() => {
        openRunDrawer(activeRunningJobCode);
      }, 400);
    }

    // Simulate completion of training
    function simulateJobFinish() {
      if (!isTrainingActive) return;
      isTrainingActive = false;

      // Update run status to success
      const run = runsList.find(r => r.code === activeRunningJobCode);
      if (run) {
        run.status = "SUCCESS";
        run.result = "v2.4";
        run.duration = "03m 15s";
      }

      // Add new version in READY state (Not auto-deployed!)
      const newVersion = {
        tag: "v2.4",
        base: run ? run.base : "v2.3",
        added: `+${selectedAlertIds.size || 5} cảnh báo`,
        date: "Hôm nay 10:48:30",
        creator: "tomhagen",
        isServing: false,
        isReady: true // Ready to deploy manually!
      };
      versionsList.unshift(newVersion);

      // Clear selection
      selectedAlertIds.clear();

      renderVersionsTable();
      renderRunsTable();
      renderAlertsTable(); // Unlocks UI!

      showToast(`Phiên chạy ${activeRunningJobCode} đã hoàn tất! Phiên bản v2.4 đã sẵn sàng áp dụng.`, 'success');
      switchDetailTab('versions');
    }

    // Render Runs Table
    function renderRunsTable() {
      const tbody = document.getElementById('runsTableBody');
      tbody.innerHTML = '';
      document.getElementById('tabCountRuns').innerText = runsList.length;

      runsList.forEach(run => {
        const tr = document.createElement('tr');
        tr.onclick = function() { openRunDrawer(run.code); };

        let statusHtml = '';

        if (run.status === 'RUNNING') {
          statusHtml = `
            <span class="status-badge badge-running">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
              Đang xử lý
            </span>`;
        } else if (run.status === 'SUCCESS') {
          statusHtml = `
            <span class="status-badge badge-success">
              <span class="status-dot" style="background: #52c41a;"></span>
              Thành công
            </span>`;
        } else {
          statusHtml = `
            <span class="status-badge badge-idle">
              <span class="status-dot" style="background: #8c93a8;"></span>
              Đã hủy
            </span>`;
        }

        tr.style.cursor = 'pointer';
        tr.title = 'Nhấp vào bản ghi để xem chi tiết lịch sử phiên chạy này';
        tr.innerHTML = `
          <td><strong style="color: var(--primary);">${run.code}</strong></td>
          <td>${run.creator}</td>
          <td>${run.date}</td>
          <td>${run.base}</td>
          <td>${run.count} cảnh báo</td>
          <td>${statusHtml}</td>
          <td><strong style="color: #fff;">${run.result}</strong></td>
          <td>${run.duration}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Deploy Modal & Workflow (Manual Activation)
    let targetDeployVersion = "";
    function openDeployModal(versionTag) {
      targetDeployVersion = versionTag;
      document.getElementById('deployTargetVersion').innerText = versionTag;
      document.getElementById('modalDeploy').classList.add('active');
    }

    function openDeployModalFromDrawer() {
      closeRunDrawer();
      openDeployModal("v2.4");
    }

    function confirmExecuteDeploy() {
      closeModal('modalDeploy');

      // Update serving flag
      versionsList.forEach(v => {
        if (v.tag === targetDeployVersion) {
          v.isServing = true;
          v.isReady = false;
        } else {
          v.isServing = false;
        }
      });

      activeServingVersion = targetDeployVersion;
      if (document.getElementById('servingVersionTitle')) {
        document.getElementById('servingVersionTitle').innerText = "Phiên bản " + targetDeployVersion;
      }
      document.getElementById('detailServingTagTop').innerText = targetDeployVersion;

      renderVersionsTable();
      showToast(`Đã kích hoạt áp dụng thành công phiên bản mô hình ${targetDeployVersion}!`, 'success');
    }

    // Rollback Modal & Workflow
    let targetRollbackVersion = "";
    function openRollbackModal(versionTag) {
      targetRollbackVersion = versionTag;
      document.getElementById('rollbackCurrentVersion').innerText = activeServingVersion;
      document.getElementById('rollbackTargetVersion').innerText = versionTag;
      document.getElementById('rollbackReasonText').value = "";
      document.getElementById('modalRollback').classList.add('active');
    }

    function confirmExecuteRollback() {
      const reason = document.getElementById('rollbackReasonText').value.trim();
      if (!reason) {
        alert("Vui lòng nhập lý do thay đổi phiên bản!");
        return;
      }

      closeModal('modalRollback');

      versionsList.forEach(v => {
        v.isServing = (v.tag === targetRollbackVersion);
        v.isReady = false;
      });

      activeServingVersion = targetRollbackVersion;
      if (document.getElementById('servingVersionTitle')) {
        document.getElementById('servingVersionTitle').innerText = "Phiên bản " + targetRollbackVersion;
      }
      document.getElementById('detailServingTagTop').innerText = targetRollbackVersion;

      renderVersionsTable();
      showToast(`Đã thay đổi phiên bản áp dụng sang ${targetRollbackVersion} thành công!`, 'success');
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
    }

    // Drawer Controls
    function openRunDrawer(jobCode) {
      document.getElementById('drawerRunCode').innerText = jobCode;
      const run = runsList.find(r => r.code === jobCode);

      if (run && run.status === 'RUNNING') {
        document.getElementById('drawerRunStatusBadge').className = 'status-badge badge-running';
        document.getElementById('drawerRunStatusBadge').innerText = 'Đang xử lý';
        document.getElementById('drawerCancelBtn').classList.remove('hidden');
      } else {
        document.getElementById('drawerRunStatusBadge').className = 'status-badge badge-success';
        document.getElementById('drawerRunStatusBadge').innerText = 'Thành công';
        document.getElementById('drawerCancelBtn').classList.add('hidden');
      }

      document.getElementById('runDrawerOverlay').classList.add('active');
      document.getElementById('runDrawerPanel').classList.add('active');
    }

    function closeRunDrawer() {
      document.getElementById('runDrawerOverlay').classList.remove('active');
      document.getElementById('runDrawerPanel').classList.remove('active');
    }

    let targetCancelJobCode = "";

    function openCancelRunModal(jobCode) {
      targetCancelJobCode = jobCode;
      if (document.getElementById('cancelRunTargetJobCode')) {
        document.getElementById('cancelRunTargetJobCode').innerText = jobCode;
      }
      document.getElementById('modalCancelRun').classList.add('active');
    }

    function confirmExecuteCancelRun() {
      closeModal('modalCancelRun');
      isTrainingActive = false;
      const run = runsList.find(r => r.code === targetCancelJobCode);
      if (run) {
        run.status = "CANCELLED";
        run.result = "—";
      }
      closeRunDrawer();
      renderRunsTable();
      renderAlertsTable(); // Unlocks UI!
      showToast(`Đã hủy tiến trình ${targetCancelJobCode}. Mô hình phục vụ được giữ nguyên.`, 'warning');
    }

    function cancelRun(jobCode) {
      openCancelRunModal(jobCode);
    }

    // Toast Utility
    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'toast-msg';

      let iconColor = '#1677ff';
      if (type === 'success') iconColor = '#52c41a';
      if (type === 'warning') iconColor = '#faad14';
      if (type === 'danger') iconColor = '#ff4d4f';

      toast.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="${iconColor}" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span>${message}</span>
      `;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.transition = 'opacity 0.3s, transform 0.3s';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Filter Model List
    function filterModelList() {
      const search = document.getElementById('modelSearchInput').value.toLowerCase();
      const rows = document.querySelectorAll('#modelsTableBody tr');
      let visibleCount = 0;

      rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(search)) {
          r.style.display = '';
          visibleCount++;
        } else {
          r.style.display = 'none';
        }
      });
      document.getElementById('modelTotalBadge').innerText = visibleCount + ' mô hình';
    }

    // Initial setups
    renderVersionsTable();
    renderRunsTable();
    renderAlertsTable();

    setInterval(() => {
      const clockEl = document.getElementById('lastUpdatedClock');
      if (clockEl) {
        const now = new Date();
        clockEl.innerText = now.toTimeString().split(' ')[0];
      }
    }, 1000);
  
    // ==========================================
    // MODULE SWITCHING & ALERTS PAGE LOGIC
    // ==========================================
    let currentMainModule = 'alerts'; // Default active module is 'alerts'

    function switchMainModule(moduleName) {
      currentMainModule = moduleName;
      const alertsView = document.getElementById('viewAlertsModule');
      const adminView = document.getElementById('viewAdminModule');
      const navAlerts = document.getElementById('navItemAlerts');
      const navAdmin = document.getElementById('navItemAdmin');

      if (moduleName === 'alerts') {
        if (alertsView) alertsView.style.display = 'block';
        if (adminView) adminView.style.display = 'none';
        if (navAlerts) navAlerts.classList.add('active');
        if (navAdmin) navAdmin.classList.remove('active');
      } else {
        if (alertsView) alertsView.style.display = 'none';
        if (adminView) adminView.style.display = 'flex';
        if (navAlerts) navAlerts.classList.remove('active');
        if (navAdmin) navAdmin.classList.add('active');
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function copyAlertId(alertId) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(alertId).then(() => {
          showToast(`Đã sao chép mã: ${alertId}`);
        }).catch(() => {
          showToast(`Mã cảnh báo: ${alertId}`);
        });
      } else {
        showToast(`Mã cảnh báo: ${alertId}`);
      }
    }

    function toggleSelectAllAlerts(masterCheckbox) {
      const rowChecks = document.querySelectorAll('.alert-row-check');
      rowChecks.forEach(cb => {
        cb.checked = masterCheckbox.checked;
      });
    }

    function onAlertRowCheckChange() {
      const rowChecks = document.querySelectorAll('.alert-row-check');
      const masterCheckbox = document.getElementById('checkAllAlerts');
      const checkedCount = Array.from(rowChecks).filter(cb => cb.checked).length;
      if (masterCheckbox) {
        masterCheckbox.checked = checkedCount === rowChecks.length && rowChecks.length > 0;
        masterCheckbox.indeterminate = checkedCount > 0 && checkedCount < rowChecks.length;
      }
    }

    function filterAlertsTable() {
      const q = (document.getElementById('alertSearchInput')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('#alertsTableBody tr');
      let visibleCount = 0;
      rows.forEach(tr => {
        const text = tr.innerText.toLowerCase();
        if (!q || text.includes(q)) {
          tr.style.display = '';
          visibleCount++;
        } else {
          tr.style.display = 'none';
        }
      });
      const countEl = document.getElementById('alertTableCount');
      if (countEl) countEl.innerText = visibleCount;
    }

    function resetAlertFilters() {
      const input = document.getElementById('alertSearchInput');
      if (input) input.value = '';
      filterAlertsTable();
      showToast('Đã đặt lại bộ lọc tìm kiếm');
    }

    function refreshAlertsTable() {
      showToast('Đang làm mới danh sách cảnh báo...');
      setTimeout(() => {
        showToast('Đã đồng bộ 42 cảnh báo mới nhất');
      }, 500);
    }

  
