        <a class="sidebar-item"><div class="sidebar-item-left"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg><span>Cấu hình hệ thống</span></div></a>
        <a class="sidebar-item"><div class="sidebar-item-left"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg><span>Nguồn tích hợp</span></div></a>
        <a class="sidebar-item"><div class="sidebar-item-left"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg><span>Healthchecks</span></div></a>
      </div>
    </aside>

    <!-- Main Content Dynamic Views -->
    <main class="app-main-content">

      <!-- ========================================== -->
      <!-- VIEW 1: MÀN HÌNH DANH SÁCH MODEL (MODEL LIST) -->
      <!-- ========================================== -->
      <section id="viewModelList">
        <div class="breadcrumbs-bar" style="margin-bottom: 12px;">
          <div class="breadcrumb-path">
            <a>Quản trị</a>
            <span>/</span>
            <span class="current">Mô hình AI</span>
          </div>
          
        </div>

        <div class="content-box">
          <!-- Toolbar -->
          <div class="table-toolbar">
            <div class="toolbar-left">
              <div class="search-input-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" class="form-control" id="modelSearchInput" placeholder="Tìm theo Mã, Tên khách hàng, Tên mô hình..." oninput="filterModelList()">
              </div>

              <select class="form-control" id="modelStatusFilter" onchange="filterModelList()">
                <option value="ALL">Trạng thái huấn luyện: Tất cả</option>
                <option value="IDLE">Đang rảnh</option>
                <option value="RUNNING">Đang huấn luyện</option>
                <option value="FAILED">Thất bại lần gần nhất</option>
              </select>
            </div>

            <div class="toolbar-right">
              <button class="btn btn-default" onclick="showToast('Đang làm mới danh sách model...', 'info')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                Làm mới
              </button>
            </div>
          </div>

          <!-- Table Header Stats -->
          <div style="padding: 12px 16px; font-weight: 600; font-size: 14px; color: #fff; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); background: rgba(0,0,0,0.1);">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span>Danh sách mô hình AI</span>
              <span class="tab-badge" id="modelTotalBadge">4 mô hình</span>
            </div>
          </div>

          <!-- Table -->
          <div class="table-responsive">
            <table class="data-table" id="modelsTable">
              <thead>
                <tr>
                  <th style="width: 50px;">STT</th>
                  <th>Khách hàng</th>
                  <th>Tên mô hình</th>
                  <th>Phiên bản đang sử dụng</th>
                  <th>Tổng số phiên bản</th>
                  <th>Trạng thái huấn luyện</th>
                  <th>Cảnh báo sai nhãn</th>
                  </tr>
              </thead>
              <tbody id="modelsTableBody">
                <!-- Row 1: PTIT -->
                <tr onclick="openModelDetail('PTIT')">
                  <td>1</td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <div class="avatar-circle" style="background: #cf1322;">PT</div>
                      <div>
                        <div style="font-weight: 600; color: #fff;">Học viện Công nghệ Bưu Chính Viễn Thông</div>
                        <div style="font-size: 11px; color: var(--text-muted);">PTIT</div>
                      </div>
                    </div>
                  </td>
                  <td><span style="font-weight: 500; color: #fff;">PTIT-Alert-Classifier-v2</span></td>
                  <td>
                    <span class="status-badge badge-serving">
                      <span class="status-dot" style="background: #1677ff;"></span>
                      v2.3
                    </span>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Áp dụng: 20/09/2026</div>
                  </td>
                  <td>4 phiên bản</td>
                  <td>
                    <span class="status-badge badge-idle">
                      <span class="status-dot" style="background: #8c93a8;"></span>
                      Đang rảnh
                    </span>
                  </td>
                  <td>
                    <span class="status-badge badge-warning" style="font-weight: 700;">
                      14 cảnh báo mới
                    </span>
                  </td>

                </tr>

                <!-- Row 2: VCB -->
                <tr onclick="openModelDetail('VCB')">
                  <td>2</td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <div class="avatar-circle" style="background: #389e0d;">VC</div>
                      <div>
                        <div style="font-weight: 600; color: #fff;">Ngân hàng Vietcombank</div>
                        <div style="font-size: 11px; color: var(--text-muted);">VCB</div>
                      </div>
                    </div>
                  </td>
                  <td><span style="font-weight: 500; color: #fff;">VCB-Security-Engine</span></td>
                  <td>
                    <span class="status-badge badge-serving">
                      <span class="status-dot" style="background: #1677ff;"></span>
                      v1.4
                    </span>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Áp dụng: 15/09/2026</div>
                  </td>
                  <td>3 phiên bản</td>
                  <td>
                    <span class="status-badge badge-running">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="animation: spin 1s linear infinite;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                      Đang xử lý (45%)
                    </span>
                  </td>
                  <td>
                    <span class="status-badge badge-idle">0 cảnh báo mới</span>
                  </td>

                </tr>

                <!-- Row 3: MASVN -->
                <tr onclick="openModelDetail('MASVN')">
                  <td>3</td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <div class="avatar-circle" style="background: #1890ff;">MA</div>
                      <div>
                        <div style="font-weight: 600; color: #fff;">Công ty Cổ phần Chứng khoán Mirae Asset</div>
                        <div style="font-size: 11px; color: var(--text-muted);">MASVN</div>
                      </div>
                    </div>
                  </td>
                  <td><span style="font-weight: 500; color: #fff;">MASVN-AI-Detector</span></td>
                  <td>
                    <span class="status-badge badge-serving">
                      <span class="status-dot" style="background: #1677ff;"></span>
                      v1.0
                    </span>
                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Áp dụng: 11/08/2026</div>
                  </td>
                  <td>1 phiên bản</td>
                  <td>
                    <span class="status-badge badge-danger">
                      <span class="status-dot" style="background: #ff4d4f;"></span>
                      Lỗi lần chạy #RT-02
                    </span>
                  </td>
                  <td>
                    <span class="status-badge badge-warning" style="font-weight: 700;">8 cảnh báo mới</span>
                  </td>

                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- VIEW 2: MÀN HÌNH CHI TIẾT MODEL (TABS)      -->
      <!-- ========================================== -->
      <section id="viewModelDetail" class="hidden">
        <!-- Breadcrumbs with Back button -->
        <div class="breadcrumbs-bar" style="margin-bottom: 12px;">
          <div class="breadcrumb-path">
            <a onclick="switchView('list')">Quản trị</a>
            <span>/</span>
            <a onclick="switchView('list')">Mô hình AI</a>
            <span>/</span>
            <span class="current" id="detailCustomerNameBreadcrumb">Học viện Công nghệ Bưu Chính Viễn Thông</span>
          </div>
          <button class="btn btn-default" style="height: 28px; padding: 2px 10px; font-size: 12px;" onclick="switchView('list')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Quay lại danh sách
          </button>
        </div>

        <!-- Detail Header Card -->
        <div class="content-box" style="padding: 16px 20px; margin-bottom: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 14px;">
              <div class="avatar-circle" id="detailCustomerAvatar" style="width: 44px; height: 44px; font-size: 16px; background: #cf1322;">PT</div>
              <div>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <h2 style="font-size: 17px; font-weight: 700; color: #fff;" id="detailCustomerTitle">Học viện Công nghệ Bưu Chính Viễn Thông</h2>
                </div>
                <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px; display: flex; align-items: center; gap: 16px;">
                  <span>Mã khách hàng: <strong style="color: #fff;" id="detailTenantId">PTIT</strong></span>
                  <span>Tên mô hình: <strong style="color: #fff;" id="detailModelName">PTIT-Alert-Classifier-v2</strong></span>
                  <span>Tổng số cảnh báo đã huấn luyện: <strong style="color: #fff;">1,420 cảnh báo</strong></span>
                </div>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="text-align: right;">
                <div style="font-size: 11px; color: var(--text-muted);">Phiên bản áp dụng hiện tại:</div>
                <div style="font-size: 15px; font-weight: 700; color: var(--primary);" id="detailServingTagTop">v2.3</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3 Tabs Container -->
        <div class="content-box">
          <div class="tabs-header">
            <button class="tab-btn active" id="tabBtnVersions" onclick="switchDetailTab('versions')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
              Danh sách phiên bản
              <span class="tab-badge" id="tabCountVersions">4</span>
            </button>

            <button class="tab-btn" id="tabBtnRetrain" onclick="switchDetailTab('retrain')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
              Huấn luyện
              <span class="tab-badge" style="background: rgba(250, 173, 20, 0.2); color: #faad14;" id="tabCountPending">32 cảnh báo</span>
            </button>

            <button class="tab-btn" id="tabBtnRuns" onclick="switchDetailTab('runs')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              Lịch sử huấn luyện
              <span class="tab-badge" id="tabCountRuns">4</span>
            </button>
          </div>

          <!-- ===================================== -->
          <!-- TAB CONTENT 1: QUẢN LÝ PHIÊN BẢN      -->
          <!-- ===================================== -->
          <div id="tabContentVersions">
            <!-- Versions Table -->
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Mã phiên bản</th>
                    <th>Phiên bản nền</th>
                    <th>Cảnh báo bổ sung</th>
                    <th>Thời điểm tạo</th>
                    <th>Người khởi tạo</th>
                    <th>Trạng thái sử dụng</th>
                    <th style="text-align: right;">Hành động</th></tr>
                </thead>
                <tbody id="versionsTableBody">
                  <!-- Dynamic version rows -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- ===================================== -->
          <!-- TAB CONTENT 2: HUẤN LUYỆN              -->
          <!-- ===================================== -->
          <div id="tabContentRetrain" class="hidden">

            <!-- Filter Toolbar with Train Button on the same row -->
            <div class="table-toolbar">
              <div class="toolbar-left">
                <div class="search-input-wrap">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <input type="text" class="form-control" id="alertSearchInput" placeholder="Tìm theo Mã cảnh báo, Tên cảnh báo..." oninput="onAlertFilterChange()">
                </div>

                <!-- Training Status Filter -->
                <select class="form-control" id="alertStatusFilter" onchange="onAlertFilterChange()">
                  <option value="ALL" selected>Trạng thái huấn luyện: Tất cả</option>
                  <option value="PENDING">Chưa huấn luyện</option>
                  <option value="TRAINED">Đã từng huấn luyện</option>
                </select>

                <!-- Direction Filter -->
                <select class="form-control" id="alertDirectionFilter" onchange="onAlertFilterChange()">
                  <option value="ALL">Chiều sai lệch: Tất cả</option>
                  <option value="TP_FP">AI TP ➔ Analyst FP (Báo nhầm)</option>
                  <option value="FP_TP">AI FP ➔ Analyst TP (Bỏ sót)</option>
                </select>

                <!-- Reporter Filter -->
                <select class="form-control" id="alertReporterFilter" onchange="onAlertFilterChange()">
                  <option value="ALL" selected>Người báo cáo: Tất cả</option>
                  <option value="admin5">admin5</option>
                  <option value="tomhagen">tomhagen</option>
                  <option value="soc_analyst_1">soc_analyst_1</option>
                  <option value="soc_analyst_2">soc_analyst_2</option>
                  <option value="soc_lead">soc_lead</option>
                </select>

                <!-- Report Time Filter -->
                <select class="form-control" id="alertReportTimeFilter" onchange="onAlertFilterChange()">
                  <option value="ALL" selected>Thời điểm báo cáo: Tất cả</option>
                  <option value="TODAY">Hôm nay</option>
                  <option value="7DAYS">7 ngày qua</option>
                  <option value="30DAYS">30 ngày qua</option>
                </select>

                <!-- Reset Filter Button next to filters -->
                <button class="btn btn-default" onclick="resetAlertFilters()">
                  Xóa bộ lọc
                </button>
              </div>

              <div class="toolbar-right" style="gap: 8px;">
                <div class="selection-info-text" style="font-size: 13px; color: var(--text-secondary);">
                  Đã chọn: <strong id="selectedCountText" style="color: var(--primary);">0</strong> / <span id="totalVisibleAlertsCount">125</span> cảnh báo
                  <span style="font-size: 11px; color: var(--text-muted); margin-left: 4px;">(Yêu cầu: 100 – 2,000 cảnh báo)</span>
                </div>
                <button class="btn btn-default" id="btnClearSelection" style="height: 32px; padding: 0 10px; font-size: 12px;" onclick="clearSelectedAlerts()">Bỏ chọn</button>
                <button class="btn btn-primary" id="btnTriggerRetrain" style="padding: 0 16px; height: 32px; font-weight: 600; font-size: 13px;" disabled onclick="openRetrainConfigModal()">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                  <span id="btnRetrainLabel">Huấn luyện</span>
                </button>
              </div>
            </div>

            <!-- Table of Alerts -->
            <div class="table-responsive">
              <table class="data-table" id="alertsSelectTable">
                <thead>
                  <tr>
                    <th style="width: 44px; text-align: center;">
                      <input type="checkbox" class="custom-checkbox" id="selectAllCheckbox" onchange="toggleSelectAllAlerts(this)">
                    </th>
                    <th>Mã cảnh báo</th>
                    <th>Tên cảnh báo</th>
                    <th>Thời gian</th>
                    <th>Kết quả AI</th>
                    <th>Kết quả báo cáo</th>
                    <th>Người báo cáo</th>
                    <th>Lý do báo cáo</th>
                    <th>Chiều sai</th>
                    <th>Trạng thái huấn luyện</th>
                    <th>Lần huấn luyện gần nhất</th>
                    <th style="text-align: center;">Chi tiết</th>
                  </tr>
                </thead>
                <tbody id="alertsSelectTableBody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>

            <!-- Pagination Bar -->
            <div class="table-pagination-bar" id="alertPaginationBar">
              <div class="pagination-left">
                <span id="alertPaginationInfo">Hiển thị 1 – 5 trong tổng số 14 cảnh báo</span>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span>Hiển thị:</span>
                  <select class="form-control" id="alertPageSizeSelect" style="height: 28px; padding: 2px 6px; font-size: 12px; width: 85px;" onchange="changeAlertPageSize(this.value)">
                    <option value="5">5 dòng</option>
                    <option value="10" selected>10 dòng</option>
                    <option value="20">20 dòng</option>
                    <option value="50">50 dòng</option>
                    <option value="100">100 dòng</option>
                  </select>
                </div>
              </div>
              <div class="pagination-controls" id="alertPaginationButtons">
                <!-- Rendered dynamically -->
              </div>
            </div>
          </div>
          <!-- ===================================== -->
          <!-- TAB CONTENT 3: LỊCH SỬ LẦN CHẠY (RUNS) -->
          <!-- ===================================== -->
          <div id="tabContentRuns" class="hidden">
            <div class="table-toolbar">
              <div class="toolbar-left">
                <span style="font-weight: 600; color: #fff; font-size: 14px;">Nhật ký các phiên huấn luyện mô hình</span>
              </div>
              
            </div>

            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Mã lần chạy</th>
                    <th>Người khởi tạo</th>
                    <th>Thời điểm chạy</th>
                    <th>Phiên bản nền</th>
                    <th>Cảnh báo bổ sung</th>
                    <th>Trạng thái</th>
                    <th>Phiên bản kết quả</th>
                    <th>Thời lượng</th></tr>
                </thead>
                <tbody id="runsTableBody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: CẤU HÌNH HUẤN LUYỆN MÔ HÌNH         -->
  <!-- ========================================== -->
  <div class="modal-overlay" id="modalRetrainConfig">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title">Cấu hình huấn luyện mô hình</h3>
        <button class="modal-close-btn" onclick="closeModal('modalRetrainConfig')">✕</button>
      </div>
      <div class="modal-body">
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; color: var(--text-muted); margin-bottom: 4px;">Khách hàng</label>
          <div style="font-size: 14px; font-weight: 600; color: #fff;" id="modalRetrainCustomer">Học viện Công nghệ Bưu Chính Viễn Thông (PTIT)</div>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 600; color: #fff; margin-bottom: 6px;">
            Chọn phiên bản nền kế thừa <span style="color: var(--danger);">*</span>
          </label>
          <select class="form-control" id="modalSelectBaseVersion" style="width: 100%;" onchange="onBaseVersionChange()">
            <!-- Options dynamically populated, default to latest -->
          </select>

        </div>

        <div style="background: rgba(22, 119, 255, 0.08); border: 1px solid rgba(22,119,255,0.25); border-radius: var(--radius-md); padding: 14px; font-size: 13px; line-height: 1.6;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span>Số cảnh báo bổ sung đã chọn:</span>
            <strong style="color: #faad14;" id="modalRetrainAlertCount">5 cảnh báo</strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
            <span>Phiên bản dự kiến sinh ra:</span>
            <strong style="color: var(--primary);" id="modalRetrainExpectedVersion">v2.4</strong>
          </div>

        </div>

        <div style="font-size: 12px; color: #ffec3d; background: rgba(250, 173, 20, 0.08); padding: 10px 12px; border-radius: var(--radius-sm); border-left: 2px solid #faad14;">
          <strong>Lưu ý:</strong> Phiên bản mới sẽ không tự động áp dụng ngay. Mô hình hiện tại vẫn tiếp tục phân loại cảnh báo bình thường. Bạn có thể kiểm tra kết quả và chủ động bấm nút <em>"Áp dụng"</em> sau khi hoàn tất.
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" onclick="closeModal('modalRetrainConfig')">Hủy bỏ</button>
        <button class="btn btn-primary" onclick="confirmExecuteRetrain()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Xác nhận & Bắt đầu huấn luyện
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: XÁC NHẬN ÁP DỤNG PHIÊN BẢN          -->
  <!-- ========================================== -->
  <div class="modal-overlay" id="modalDeploy">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title">Xác nhận áp dụng phiên bản</h3>
        <button class="modal-close-btn" onclick="closeModal('modalDeploy')">✕</button>
      </div>
      <div class="modal-body">
        <div style="background: rgba(82, 196, 26, 0.08); border: 1px solid rgba(82, 196, 26, 0.25); border-radius: var(--radius-md); padding: 14px; font-size: 13px;">
          <div style="color: #52c41a; font-weight: 600; margin-bottom: 6px;">✓ Xác nhận đưa phiên bản mới vào áp dụng</div>
          <div>
            Bạn đang yêu cầu chuyển đổi phiên bản mô hình của khách hàng <strong style="color: #fff;" id="deployCustomerName">PTIT</strong> sang phiên bản <strong style="color: var(--primary);" id="deployTargetVersion">v2.4</strong>.
          </div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px;">
            Phiên bản này sẽ ngay lập tức được sử dụng để đánh giá và phân loại tất cả các cảnh báo an ninh mới đẩy về.
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; color: #fff; margin-bottom: 6px;">
            Ghi chú áp dụng (Tùy chọn)
          </label>
          <input type="text" class="form-control" id="deployNoteInput" style="width: 100%;" placeholder="VD: Đã kiểm thử F1-score đạt 95%, phê duyệt đưa vào áp dụng">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" onclick="closeModal('modalDeploy')">Hủy</button>
        <button class="btn btn-success" onclick="confirmExecuteDeploy()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Áp dụng ngay
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: THAY ĐỔI PHIÊN BẢN ÁP DỤNG         -->
  <!-- ========================================== -->
  <div class="modal-overlay" id="modalRollback">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title">Thay đổi phiên bản áp dụng</h3>
        <button class="modal-close-btn" onclick="closeModal('modalRollback')">✕</button>
      </div>
      <div class="modal-body">
        <div style="background: rgba(22, 119, 255, 0.08); border: 1px solid rgba(22, 119, 255, 0.25); border-radius: var(--radius-md); padding: 14px; font-size: 13px;">
          <div style="color: #4096ff; font-weight: 600; margin-bottom: 6px;">Xác nhận thay đổi phiên bản áp dụng</div>
          <div>
            Bạn đang yêu cầu chuyển đổi phiên bản mô hình của khách hàng <strong style="color: #fff;">PTIT</strong> từ phiên bản <strong style="color: var(--danger);" id="rollbackCurrentVersion">v2.3</strong> sang phiên bản <strong style="color: #52c41a;" id="rollbackTargetVersion">v2.2</strong>.
          </div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 6px;">
            Hệ thống sẽ ngay lập tức sử dụng phiên bản được chọn để phân loại cảnh báo mới.
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; color: #fff; margin-bottom: 6px;">
            Lý do thay đổi <span style="color: var(--danger);">*</span>
          </label>
          <textarea class="form-control" id="rollbackReasonText" rows="3" style="width: 100%; height: auto; resize: vertical;" placeholder="Nhập lý do thay đổi phiên bản áp dụng..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" onclick="closeModal('modalRollback')">Hủy</button>
        <button class="btn btn-primary" onclick="confirmExecuteRollback()">
          Xác nhận thay đổi
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MODAL: XÁC NHẬN HỦY TIẾN TRÌNH HUẤN LUYỆN  -->
  <!-- ========================================== -->
  <div class="modal-overlay" id="modalCancelRun" style="z-index: 1050;">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title" style="color: #ff4d4f; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ff4d4f" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Xác nhận hủy tiến trình
        </h3>
        <button class="modal-close-btn" onclick="closeModal('modalCancelRun')">✕</button>
      </div>
      <div class="modal-body">
        <div style="background: rgba(255, 77, 79, 0.08); border: 1px solid rgba(255, 77, 79, 0.25); border-radius: var(--radius-md); padding: 14px; font-size: 13px; line-height: 1.6;">
          <div style="color: #ff4d4f; font-weight: 600; margin-bottom: 6px;">Cảnh báo hủy tiến trình đang huấn luyện</div>
          <div>
            Bạn có chắc chắn muốn hủy tiến trình huấn luyện mô hình <strong style="color: #fff;" id="cancelRunTargetJobCode">#RT-20260930-01</strong> không?
          </div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 8px; line-height: 1.5;">
            • Quá trình huấn luyện sẽ dừng lại ngay lập tức.<br>
            • Dữ liệu tạm của phiên chạy sẽ bị xóa và không sinh ra phiên bản mô hình mới.<br>
            • Phiên bản mô hình đang áp dụng hiện tại vẫn tiếp tục hoạt động bình thường, không bị gián đoạn.
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" onclick="closeModal('modalCancelRun')">Hủy bỏ</button>
        <button class="btn btn-danger" onclick="confirmExecuteCancelRun()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
          Xác nhận hủy tiến trình
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- DRAWER: CHI TIẾT LẦN CHẠY (RUN DETAIL)     -->
  <!-- ========================================== -->
  <div class="drawer-overlay" id="runDrawerOverlay" onclick="closeRunDrawer()"></div>
  <aside class="drawer-panel" id="runDrawerPanel">
    <div class="drawer-header">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 10px;">
          <span id="drawerRunCode">#RT-20260929-01</span>
          <span class="status-badge badge-running" id="drawerRunStatusBadge">Đang xử lý</span>
        </h3>
        <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
          Khách hàng: <strong style="color: #fff;">PTIT</strong> | Khởi tạo bởi: <strong style="color: #fff;">tomhagen</strong>
        </div>
      </div>
      <button class="modal-close-btn" onclick="closeRunDrawer()">✕</button>
    </div>

    <div class="drawer-body">
      <!-- 5-Step Stepper -->
      <div>
        <div style="font-weight: 600; color: #fff; font-size: 13px; margin-bottom: 12px;">Tiến trình thực hiện:</div>
        <div class="stepper">
          <div class="step-item completed">
            <div class="step-line"></div>
            <div class="step-icon-wrap">✓</div>
            <div class="step-content">
              <div class="step-title">
                <span>1. Tiếp nhận & Đóng băng Snapshot</span>
                <span style="font-size: 11px; color: var(--success);">Hoàn tất</span>
              </div>
              <div class="step-desc">Đã kiểm tra và snapshot các alert được chọn.</div>
            </div>
          </div>

          <div class="step-item completed">
            <div class="step-line"></div>
            <div class="step-icon-wrap">✓</div>
            <div class="step-content">
              <div class="step-title">
                <span>2. Chuyển giao AI Service</span>
                <span style="font-size: 11px; color: var(--success);">Hoàn tất</span>
              </div>
              <div class="step-desc">AI Engine tiếp nhận yêu cầu, cấp phát node GPU.</div>
            </div>
          </div>

          <div class="step-item active" id="drawerStep3">
            <div class="step-line"></div>
            <div class="step-icon-wrap">3</div>
            <div class="step-content">
              <div class="step-title">
                <span>3. Huấn luyện mô hình</span>
                <span style="font-size: 11px; color: var(--primary);" id="drawerStep3Status">Đang chạy</span>
              </div>
              <div class="step-desc">Kế thừa trọng số từ Base Version và tinh chỉnh dữ liệu bổ sung.</div>
            </div>
          </div>

          <div class="step-item" id="drawerStep4">
            <div class="step-line"></div>
            <div class="step-icon-wrap">4</div>
            <div class="step-content">
              <div class="step-title">
                <span>4. Đánh giá & Kiểm thử</span>
                <span style="font-size: 11px; color: var(--text-muted);" id="drawerStep4Status">Chờ</span>
              </div>
              <div class="step-desc">Kiểm tra F1-Score, Precision, Recall so với bản nền.</div>
            </div>
          </div>

          <div class="step-item" id="drawerStep5">
            <div class="step-icon-wrap">5</div>
            <div class="step-content">
              <div class="step-title">
                <span>5. Sinh phiên bản mới</span>
                <span style="font-size: 11px; color: var(--text-muted);" id="drawerStep5Status">Chờ</span>
              </div>
              <div class="step-desc">Lưu trữ mô hình ở trạng thái Sẵn sàng (Chờ người dùng duyệt áp dụng).</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Dataset Snapshot -->
      <div>
        <div style="font-weight: 600; color: #fff; font-size: 13px; margin-bottom: 8px;">Dữ liệu Snapshot trong phiên chạy:</div>
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 10px 12px; font-size: 12px; margin-bottom: 10px; display: flex; justify-content: space-between;">
          <span>Phiên bản nền: <strong id="drawerBaseVersion">v2.3</strong></span>
          <span>Số cảnh báo: <strong style="color: #faad14;" id="drawerAlertCount">5</strong></span>
          <span>Mô hình kết quả: <strong style="color: var(--primary);" id="drawerResultVersion">v2.4</strong></span>
        </div>
      </div>
    </div>

    <div class="drawer-footer">
      <div id="drawerActionLeft">
        <button class="btn btn-danger" id="drawerCancelBtn" onclick="openCancelRunModal(document.getElementById('drawerRunCode').innerText)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
          Hủy tiến trình
        </button>
      </div>
      <button class="btn btn-default" onclick="closeRunDrawer()">Đóng</button>
    </div>
  </aside>

  <!-- Toast Notification Container -->
  
  <!-- ========================================== -->
  <!-- MODAL: PHẢN HỒI KẾT QUẢ ĐÁNH GIÁ AI        -->
  <!-- ========================================== -->
  <div class="modal-overlay" id="modalAiFeedback" style="z-index: 1100;">
    <div class="modal-dialog" style="max-width: 480px;">
      <div class="modal-header">
        <h3 class="modal-title">Phản hồi kết quả đánh giá AI</h3>
        <button class="modal-close-btn" onclick="closeAiFeedbackModal()">✕</button>
      </div>
      <div class="modal-body" style="display: flex; flex-direction: column; gap: 14px;">
        <!-- Two result rows (Read-only) -->
        <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 12px 14px; display: flex; flex-direction: column; gap: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 13px; color: var(--text-muted);">Kết quả AI đánh giá:</span>
            <span class="alert-badge-tag crit" id="feedbackModalAiVerdict" style="font-size: 12px; padding: 2px 8px;">Cảnh báo thật (100%)</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 13px; color: var(--text-muted);">Kết quả người dùng đánh giá:</span>
            <span class="alert-badge-tag" id="feedbackModalUserVerdict" style="background: rgba(82, 196, 26, 0.12); border: 1px solid rgba(82, 196, 26, 0.3); color: #52c41a; font-size: 12px; padding: 2px 8px;">Cảnh báo giả</span>
          </div>
        </div>

        <!-- Reason input -->
        <div>
          <label style="display: block; font-size: 12px; font-weight: 500; color: #fff; margin-bottom: 6px;">
            Lý do <span style="color: var(--danger);">*</span>
          </label>
          <textarea class="form-control" id="aiFeedbackReason" rows="3" style="width: 100%; resize: vertical; min-height: 80px; font-size: 13px; line-height: 1.5;" placeholder="Nhập lý do đánh giá kết quả AI chưa đúng..."></textarea>
          <div id="aiFeedbackReasonError" style="display: none; color: var(--danger); font-size: 11px; margin-top: 4px;">Vui lòng nhập lý do phản hồi kết quả AI.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" onclick="closeAiFeedbackModal()">Hủy</button>
        <button class="btn btn-primary" onclick="confirmAiFeedback()">Xác nhận</button>
      </div>
    </div>
  </div>

  
  <!-- Modal: Xác nhận hủy báo cáo kết quả AI -->
  <div class="modal-overlay" id="modalConfirmCancelAiFeedback" style="z-index: 1250;">
    <div class="modal-dialog" style="max-width: 440px;">
      <div class="modal-header">
        <h3 class="modal-title">Xác nhận hủy báo cáo</h3>
