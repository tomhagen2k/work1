    let isOrigFieldNames = false;

    function openAlertDetail(alertId) {
      const data = alertDetailsData[alertId] || alertDetailsData["8665eccd-e611-47d1-b32e-82f78026a82b"];
      
      // Populate Header
      const idEl = document.getElementById('detailAlertId');
      if (idEl) idEl.innerText = alertId;
      const srcEl = document.getElementById('detailSource');
      if (srcEl) srcEl.innerText = data.source;
      const timeEl = document.getElementById('detailTime');
      if (timeEl) timeEl.innerText = data.time;
      const tenantEl = document.getElementById('detailTenantName');
      if (tenantEl) tenantEl.innerText = `${data.tenant} (${data.customer})`;

      // Tags
      const sevTag = document.getElementById('detailSeverityTag');
      if (sevTag) {
        sevTag.className = `alert-badge-tag ${data.severityClass}`;
        sevTag.innerHTML = `◆ ${data.severity}`;
      }
      currentDetailAlertId = alertId;
      updateAiTagUI(data);
      const statusTag = document.getElementById('detailStatusTag');
      if (statusTag) {
        statusTag.className = `alert-badge-tag ${data.statusClass}`;
        statusTag.innerText = data.status;
      }
      const caseCode = document.getElementById('detailCaseCode');
      if (caseCode) caseCode.innerText = data.caseId;

      // Left Column Fields
      const kvSev = document.getElementById('kvSeverity');
      if (kvSev) kvSev.innerText = data.severity;
      const kvSrc = document.getElementById('kvSource');
      if (kvSrc) kvSrc.innerText = data.source;
      const kvCnt = document.getElementById('kvContent');
      if (kvCnt) kvCnt.innerText = data.content;
      const kvSrcIp = document.getElementById('kvSrcIp');
      if (kvSrcIp) kvSrcIp.innerText = data.srcIp;
      const kvSrcIpPt = document.getElementById('kvSrcIpPt');
      if (kvSrcIpPt) kvSrcIpPt.innerText = data.srcIp;
      const kvDstIp = document.getElementById('kvDstIp');
      if (kvDstIp) kvDstIp.innerText = data.dstIp;
      const kvDstIpPt = document.getElementById('kvDstIpPt');
      if (kvDstIpPt) kvDstIpPt.innerText = data.dstIp;
      const kvTenant = document.getElementById('kvTenant');
      if (kvTenant) kvTenant.innerText = data.tenant;
      const kvCust = document.getElementById('kvCustomer');
      if (kvCust) kvCust.innerText = data.customer;

      // Update JSON preview code block
      const jsonEl = document.getElementById('alertDetailJsonCode');
      if (jsonEl) {
        const fullObj = {
          alert_id: alertId,
          timestamp: data.time,
          severity: data.severity,
          status: data.status.replace('● ', ''),
          source: data.source,
          tenant: data.tenant,
          customer: data.customer,
          incident_id: data.caseId,
          src_ip: data.srcIp,
          dst_ip: data.dstIp,
          content: data.content,
          ai_evaluation: data.aiVerdict
        };
        jsonEl.innerText = JSON.stringify(fullObj, null, 2);
      }

      // Open drawer
      const overlay = document.getElementById('alertDetailOverlay');
      if (overlay) overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeAlertDetail() {
      const overlay = document.getElementById('alertDetailOverlay');
      if (overlay) overlay.classList.remove('active');
      document.body.style.overflow = '';
      closeAlertDetailActionMenu();
    }

    function closeAlertDetailOnOverlay(e) {
      if (e.target.id === 'alertDetailOverlay') {
        closeAlertDetail();
      }
    }

    function switchAlertDetailTab(tabName) {
      // Buttons
      document.getElementById('alertTabBtnEvents')?.classList.toggle('active', tabName === 'events');
      document.getElementById('alertTabBtnJson')?.classList.toggle('active', tabName === 'json');
      document.getElementById('alertTabBtnHistory')?.classList.toggle('active', tabName === 'history');

      // Panes
      const paneEvents = document.getElementById('alertTabPaneEvents');
      const paneJson = document.getElementById('alertTabPaneJson');
      const paneHistory = document.getElementById('alertTabPaneHistory');

      if (paneEvents) paneEvents.style.display = tabName === 'events' ? 'block' : 'none';
      if (paneJson) paneJson.style.display = tabName === 'json' ? 'block' : 'none';
      if (paneHistory) paneHistory.style.display = tabName === 'history' ? 'block' : 'none';
    }

    function toggleAlertEventAccordion(index) {
      const body = document.getElementById(`eventBody${index}`);
      const arrow = document.getElementById(`accordionArrow${index}`);
      if (!body) return;
      const isHidden = body.style.display === 'none';
      body.style.display = isHidden ? 'block' : 'none';
      if (arrow) arrow.innerText = isHidden ? '▼' : '▶';
    }

    let allEventsExpanded = false;
    function toggleAllAlertEvents() {
      allEventsExpanded = !allEventsExpanded;
      for (let i = 1; i <= 3; i++) {
        const body = document.getElementById(`eventBody${i}`);
        const arrow = document.getElementById(`accordionArrow${i}`);
        if (body) body.style.display = allEventsExpanded ? 'block' : 'none';
        if (arrow) arrow.innerText = allEventsExpanded ? '▼' : '▶';
      }
    }

    function toggleAlertEventViewMode(index, mode) {
      const fieldsView = document.getElementById(`eventFieldsView${index}`);
      const jsonView = document.getElementById(`eventJsonView${index}`);
      const btnFields = document.getElementById(`btnToggleFields${index}`);
      const btnJson = document.getElementById(`btnToggleJson${index}`);

      if (mode === 'fields') {
        if (fieldsView) fieldsView.style.display = 'block';
        if (jsonView) jsonView.style.display = 'none';
        btnFields?.classList.add('active');
        btnJson?.classList.remove('active');
      } else {
        if (fieldsView) fieldsView.style.display = 'none';
        if (jsonView) jsonView.style.display = 'block';
        btnFields?.classList.remove('active');
        btnJson?.classList.add('active');
      }
    }

    function toggleAlertOriginalFieldNames() {
      isOrigFieldNames = !isOrigFieldNames;
      const btn = document.getElementById('btnToggleOrigNames');
      if (btn) {
        btn.style.color = isOrigFieldNames ? '#1677ff' : '#8c93a8';
        btn.style.borderColor = isOrigFieldNames ? '#1677ff' : '#272f44';
      }
      const mapping = {
        "severity": isOrigFieldNames ? "event.severity" : "Mức độ",
        "source": isOrigFieldNames ? "event.source" : "Nguồn",
        "content": isOrigFieldNames ? "alert.description" : "Nội dung",
        "src_ip_pt": isOrigFieldNames ? "source.ip.parsed" : "IP nguồn PT",
        "dst_ip_pt": isOrigFieldNames ? "destination.ip.parsed" : "IP đích PT",
        "tenant": isOrigFieldNames ? "customer.tenant_id" : "Mã Tenant",
        "customer": isOrigFieldNames ? "customer.name" : "Khách hàng",
        "src_ip": isOrigFieldNames ? "source.ip" : "IP nguồn",
        "dst_ip": isOrigFieldNames ? "destination.ip" : "IP đích",
        "src_country": isOrigFieldNames ? "source.geo.country_name" : "Quốc gia nguồn",
        "dst_country": isOrigFieldNames ? "destination.geo.country_name" : "Quốc gia đích",
        "rule_type": isOrigFieldNames ? "rule.category" : "qưet",
        "prod_smoke_src_ip": isOrigFieldNames ? "prod_smoke_src_ip" : "prod_smoke_src_ip"
      };

      document.querySelectorAll('#detailKvTable td[data-field]').forEach(td => {
        const fieldKey = td.getAttribute('data-field');
        if (mapping[fieldKey]) {
          td.innerText = mapping[fieldKey];
        }
      });
      showToast(isOrigFieldNames ? 'Đang hiển thị Tên gốc' : 'Đang hiển thị Tên thân thiện');
    }

    function toggleAlertDetailActionMenu(e) {
      e.stopPropagation();
      const menu = document.getElementById('detailActionMenu');
      if (menu) menu.classList.toggle('show');
    }

    function closeAlertDetailActionMenu() {
      const menu = document.getElementById('detailActionMenu');
      if (menu) menu.classList.remove('show');
    }

    document.addEventListener('click', () => {
      closeAlertDetailActionMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const overlay = document.getElementById('alertDetailOverlay');
        if (overlay && overlay.classList.contains('active')) {
          closeAlertDetail();
        }
      }
    });

    function executeAlertDetailAction(action) {
      closeAlertDetailActionMenu();
      const alertId = document.getElementById('detailAlertId')?.innerText || '';
      if (action === 'create_case') {
        showToast(`Đã mở giao diện tạo sự việc mới từ cảnh báo ${alertId}`);
      } else if (action === 'assign_case') {
        showToast(`Đã mở danh sách chọn sự việc để gán cảnh báo ${alertId}`);
      } else if (action === 'mark_false_positive') {
        showToast(`Đã đánh dấu cảnh báo ${alertId} là Cảnh báo giả`);
      } else if (action === 'change_status') {
        showToast(`Đang chuyển trạng thái cảnh báo ${alertId}`);
      }
    }

    function copyAlertDetailJson() {
      const jsonText = document.getElementById('alertDetailJsonCode')?.innerText || '';
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(jsonText).then(() => {
          showToast('Đã sao chép toàn bộ JSON cảnh báo vào bộ nhớ tạm');
        });
      } else {
        showToast('Đã sao chép JSON cảnh báo');
      }
    }

    function copyEventRawJson(index) {
      const el = document.querySelector(`#eventJsonView${index} pre`);
      if (el && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(el.innerText).then(() => {
          showToast(`Đã sao chép JSON của Sự kiện #${index}`);
        });
      } else {
        showToast(`Đã sao chép JSON Sự kiện #${index}`);
      }
    }

    function filterAlertEvents(val) {
      const q = (val || '').toLowerCase().trim();
      for (let i = 1; i <= 3; i++) {
        const item = document.getElementById(`eventItem${i}`);
        if (!item) continue;
        const text = item.innerText.toLowerCase();
        item.style.display = (!q || text.includes(q)) ? '' : 'none';
      }
    }

  
    // ==========================================
    // AI FEEDBACK (BÁO CÁO SAI NHÃN) LOGIC
    // ==========================================
    let currentDetailAlertId = "68880d7c-b1b5-4a8b-9db";

    function updateAiTagUI(data) {
      const aiTag = document.getElementById('detailAiTag');
      if (!aiTag) return;

      if (data.isReported) {
        aiTag.className = 'alert-badge-tag ai reported';
        const cleanVerdict = data.aiVerdict.replace(/^■\s*/, '');
        const rUser = data.reportUser || 'tomhagen';
        const rTime = data.reportTime || '01/10/2026 09:15:30';
        const rReason = data.reportReason || 'Chưa có lý do';
        
        aiTag.innerHTML = `
          <span>■ <span style="text-decoration: line-through; opacity: 0.85;">${cleanVerdict}</span></span>
          <span class="alert-ai-reported-label">
            <span class="alert-ai-reported-text">(Đã báo cáo sai ⚠️)</span>
            <span class="alert-ai-tooltip">
              <span class="tooltip-line1">${rUser} - ${rTime}</span>
              <span class="tooltip-line2">Lý do: ${rReason}</span>
            </span>
          </span>
          <button class="alert-ai-cancel-btn" onclick="openConfirmCancelAiFeedbackModal(event)" title="Hủy báo cáo này">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        `;
      } else {
        aiTag.className = `alert-badge-tag ${data.aiClass}`;
        const canReport = data.aiVerdict && !data.aiVerdict.includes('Chưa có kết quả');
        aiTag.innerHTML = `
          <span>${data.aiVerdict}</span>
          ${canReport ? `
            <button class="alert-ai-report-btn" onclick="openAiFeedbackModal(event)" title="Báo cáo kết quả AI đánh giá chưa đúng">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
              Báo cáo
            </button>
          ` : ''}
        `;
      }
    }

    function openAiFeedbackModal(e) {
      if (e) e.stopPropagation();
      const data = alertDetailsData[currentDetailAlertId] || alertDetailsData["68880d7c-b1b5-4a8b-9db"];
      
      const modalAiVerdict = document.getElementById('feedbackModalAiVerdict');
      const modalUserVerdict = document.getElementById('feedbackModalUserVerdict');
      const reasonInput = document.getElementById('aiFeedbackReason');
      const errorMsg = document.getElementById('aiFeedbackReasonError');

      if (modalAiVerdict) {
        modalAiVerdict.innerText = data.aiVerdict.replace('■ ', '');
      }
      if (modalUserVerdict) {
        const isReal = data.aiVerdict.includes('thật');
        modalUserVerdict.innerText = isReal ? 'Cảnh báo giả' : 'Cảnh báo thật';
      }
      if (reasonInput) {
        reasonInput.value = data.reportReason || '';
      }
      if (errorMsg) {
        errorMsg.style.display = 'none';
      }

      const modal = document.getElementById('modalAiFeedback');
      if (modal) modal.classList.add('active');
    }

    function closeAiFeedbackModal() {
      const modal = document.getElementById('modalAiFeedback');
      if (modal) modal.classList.remove('active');
    }

    function confirmAiFeedback() {
      const reasonInput = document.getElementById('aiFeedbackReason');
      const reason = (reasonInput?.value || '').trim();
      const errorMsg = document.getElementById('aiFeedbackReasonError');

      if (!reason) {
        if (errorMsg) errorMsg.style.display = 'block';
        if (reasonInput) reasonInput.focus();
        return;
      }

      const data = alertDetailsData[currentDetailAlertId] || alertDetailsData["68880d7c-b1b5-4a8b-9db"];
      data.isReported = true;
      data.reportReason = reason;
      const isReal = data.aiVerdict.includes('thật');
      data.userVerdict = isReal ? 'Cảnh báo giả' : 'Cảnh báo thật';

      const now = new Date();
      const timeStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth()+1).padStart(2, '0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
      data.reportUser = 'tomhagen';
      data.reportTime = timeStr;

      // Update Tag UI
      updateAiTagUI(data);

      // Append log to System Log tab
      const logBody = document.getElementById('alertDetailLogBody');
      if (logBody) {
        const tr = document.createElement('tr');
        tr.id = `log-report-${currentDetailAlertId}`;
        tr.innerHTML = `
          <td class="alert-log-time">${timeStr}</td>
          <td class="alert-log-user">tomhagen</td>
          <td class="alert-log-action" style="color: #faad14;">Báo cáo kết quả AI</td>
          <td>Đổi từ <strong>${data.aiVerdict}</strong> sang <strong style="color: #52c41a;">${data.userVerdict}</strong>. Lý do: ${reason}</td>
        `;
        logBody.insertBefore(tr, logBody.firstChild);
      }

      closeAiFeedbackModal();
      showToast('Đã lưu phản hồi kết quả AI thành công');
    }

    function openConfirmCancelAiFeedbackModal(e) {
      if (e) e.stopPropagation();
      const data = alertDetailsData[currentDetailAlertId] || alertDetailsData["68880d7c-b1b5-4a8b-9db"];
      const verdictEl = document.getElementById('cancelModalAiVerdict');
      if (verdictEl) {
        verdictEl.innerText = data.aiVerdict.replace(/^■\s*/, '');
      }
      const modal = document.getElementById('modalConfirmCancelAiFeedback');
      if (modal) modal.classList.add('active');
    }

    function closeConfirmCancelAiFeedbackModal() {
      const modal = document.getElementById('modalConfirmCancelAiFeedback');
      if (modal) modal.classList.remove('active');
    }

    function confirmExecuteCancelAiFeedback() {
      const data = alertDetailsData[currentDetailAlertId] || alertDetailsData["68880d7c-b1b5-4a8b-9db"];
      data.isReported = false;
      data.reportReason = '';
      data.reportTime = '';

      // Revert Tag UI
      updateAiTagUI(data);

      // Append log
      const now = new Date();
      const timeStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth()+1).padStart(2, '0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
      
      const logBody = document.getElementById('alertDetailLogBody');
      if (logBody) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="alert-log-time">${timeStr}</td>
          <td class="alert-log-user">tomhagen</td>
          <td class="alert-log-action" style="color: #8c93a8;">Hủy báo cáo kết quả AI</td>
          <td>Khôi phục về trạng thái phán định gốc của AI: <strong>${data.aiVerdict}</strong></td>
        `;
        logBody.insertBefore(tr, logBody.firstChild);
      }

      closeConfirmCancelAiFeedbackModal();
      showToast('Đã hủy báo cáo kết quả AI');
    }

  </script>
</body>
</html>